---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { getTechIconUrl } from "../utils/icons";

const rawProjects = await getCollection("projects");

const allProjects = await Promise.all(
  rawProjects.map(async (project) => {
    let coverUrl = project.data.cover;
    if (!coverUrl) {
      const urls = [
        project.data.ctaHref,
        project.data.repoHref,
        project.data.resultHref,
      ];
      for (const url of urls) {
        if (url) {
          if (url.includes("github.com")) {
            const match = url.match(/github\.com\/([^\/]+)\/([^\/]+)/);
            if (match) {
              const owner = match[1];
              let repo = match[2].split(/[?#]/)[0];
              if (repo.endsWith(".git")) repo = repo.slice(0, -4);
              coverUrl = `https://opengraph.githubassets.com/1/${owner}/${repo}`;
              break;
            }
          } else if (url.includes("spotify.com")) {
            try {
              const res = await fetch(
                `https://open.spotify.com/oembed?url=${encodeURIComponent(url)}`,
              );
              if (res.ok) {
                const data = (await res.json()) as { thumbnail_url?: string };
                if (data.thumbnail_url) {
                  coverUrl = data.thumbnail_url;
                  break;
                }
              }
            } catch (err) {
              console.error(`Failed to fetch Spotify oEmbed for ${url}:`, err);
            }
          }
        }
      }
    }
    return {
      ...project,
      resolvedCoverUrl: coverUrl,
    };
  }),
);

// Sort: year (descending), featured (featured first), title (alphabetical)
allProjects.sort((a, b) => {
  const yearA = a.data.year ?? 0;
  const yearB = b.data.year ?? 0;
  if (yearB !== yearA) {
    return yearB - yearA;
  }
  const featA = a.data.featured ? 1 : 0;
  const featB = b.data.featured ? 1 : 0;
  if (featB !== featA) {
    return featB - featA;
  }
  return a.data.title.localeCompare(b.data.title);
});

// Get unique categories for filters
const categories = ["All", ...new Set(allProjects.map((p) => p.data.category))];
---

<Layout
  title="Portfolio | Alyani Septalia"
  description="Projects completed by Alyani Septalia."
>
  <style>
    #projects-grid {
      display: grid;
      grid-template-columns: repeat(1, 1fr);
      grid-auto-rows: 10px;
      gap: 24px;
    }
    @media (min-width: 768px) {
      #projects-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (min-width: 1024px) {
      #projects-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }
  </style>
  <div class="flex flex-col gap-10 w-full">
    <!-- Header Area -->
    <div class="flex flex-col gap-3">
      <h1
        class="text-3xl md:text-4xl font-mono uppercase tracking-wide text-forest-dark"
      >
        Works & Projects
      </h1>
      <p class="text-sage-muted text-sm">
        A collection of projects across data analytics, software development,
        and digital systems.
      </p>
    </div>

    <!-- Category Filter Pills -->
    <div class="flex flex-wrap gap-2" id="filter-container">
      {
        categories.map((category, index) => (
          <button
            type="button"
            data-filter={category}
            class={`btn btn-xs sm:btn-sm rounded-full font-mono uppercase tracking-wider ${
              index === 0
                ? "btn-primary text-surface"
                : "btn-outline border-sage-border/50 text-sage-muted hover:bg-sage-accent hover:text-surface hover:border-sage-accent"
            }`}
          >
            {category}
          </button>
        ))
      }
    </div>

    <!-- Masonry Grid Layout -->
    <div class="w-full" id="projects-grid">
      {
        allProjects.map((project) => {
          const targetUrl =
            project.data.ctaHref ||
            project.data.repoHref ||
            project.data.resultHref ||
            "#";

          const coverUrl = project.resolvedCoverUrl;
          const hasCover = !!coverUrl;

          return (
            <div
              data-category={project.data.category}
              class="project-card flex flex-col bg-surface border border-sage-border/40 rounded-xl overflow-hidden shadow-none hover:shadow-sm hover:border-sage-accent transition-all duration-300 transform hover:-translate-y-1 opacity-100"
            >
              <div class="project-card-inner flex flex-col w-full h-full">
                {/* Project Cover Asset */}
                {hasCover ? (
                  <div class="w-full overflow-hidden bg-cream/30">
                    <img
                      src={coverUrl}
                      alt={project.data.title}
                      loading="lazy"
                      onload="if(window.resizeAllGridItems) window.resizeAllGridItems();"
                      class="w-full h-auto object-cover border-b border-sage-border/20 transition-transform duration-500 hover:scale-102"
                    />
                  </div>
                ) : (
                  /* fallback placeholder for cards without cover images & not hosted on GitHub */
                  <div class="w-full p-8 border-b border-sage-border/20 bg-gradient-to-br from-cream/20 to-sage-border/10 flex flex-col justify-between min-h-[140px]">
                    <div class="flex justify-between items-start">
                      <span class="text-[10px] font-mono tracking-widest text-sage-accent uppercase bg-cream px-2 py-0.5 rounded-md border border-sage-border/30">
                        Project
                      </span>
                      {project.data.year && (
                        <span class="text-[10px] font-mono text-sage-muted">
                          {project.data.year}
                        </span>
                      )}
                    </div>
                    <div class="font-mono text-xs text-sage-accent font-bold mt-4 break-words">
                      {project.data.category.toUpperCase()}
                    </div>
                  </div>
                )}

                {/* Caption / Content Below the Asset */}
                <div class="p-6 flex flex-col flex-grow gap-4">
                  <div class="flex justify-between items-start gap-2">
                    <span class="text-[10px] font-mono tracking-wider text-sage-accent uppercase">
                      {project.data.category}
                    </span>
                    {project.data.year && hasCover && (
                      <span class="text-[10px] font-mono text-sage-muted">
                        {project.data.year}
                      </span>
                    )}
                  </div>

                  <div class="flex flex-col gap-2">
                    <h3 class="font-mono text-sm font-bold text-forest-dark leading-snug group-hover:text-sage-accent">
                      {project.data.title}
                    </h3>
                    {project.data.description && (
                      <p class="text-xs text-sage-muted leading-relaxed">
                        {project.data.description}
                      </p>
                    )}
                  </div>

                  {/* Technologies / Stack Badges */}
                  {project.data.stack && project.data.stack.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 pt-2">
                      {project.data.stack.map((tech) => {
                        const iconUrl = getTechIconUrl(tech);
                        return (
                          <span class="inline-flex items-center gap-1.5 bg-surface border border-sage-border/30 rounded-full px-2.5 py-0.5 shadow-xs hover:border-sage-accent transition-colors duration-300">
                            <img
                              src={iconUrl}
                              alt={tech}
                              class="w-3.5 h-3.5 object-contain"
                            />
                            <span class="text-[9px] font-mono text-sage-muted">
                              {tech}
                            </span>
                          </span>
                        );
                      })}
                    </div>
                  )}

                  {/* Project Link Buttons */}
                  <div class="flex flex-wrap gap-2 pt-4 mt-auto border-t border-sage-border/10">
                    {project.data.repoHref && (
                      <a
                        href={project.data.repoHref}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-xs sm:btn-sm btn-primary rounded-full font-mono text-[9px] sm:text-[10px] uppercase tracking-wider text-surface gap-1"
                      >
                        <svg
                          class="w-3 h-3 sm:w-3.5 sm:h-3.5"
                          fill="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path d="M12 .5c-6.35 0-11.5 5.16-11.5 11.53 0 5.09 3.34 9.4 7.98 10.92.58.11.8-.25.8-.56 0-.28-.01-1.02-.02-2.01-3.25.71-3.94-1.57-3.94-1.57-.53-1.37-1.3-1.73-1.3-1.73-1.06-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.04 1.79 2.73 1.27 3.4.97.11-.77.41-1.27.75-1.56-2.6-.3-5.33-1.3-5.33-5.78 0-1.27.45-2.32 1.19-3.13-.12-.3-.52-1.49.11-3.11 0 0 .98-.31 3.2 1.2.93-.26 1.93-.39 2.92-.39.99 0 1.99.13 2.92.39 2.22-1.51 3.2-1.2 3.2-1.2.63 1.62.23 2.81.11 3.11.74.81 1.19 1.86 1.19 3.13 0 4.49-2.74 5.48-5.35 5.77.42.37.79 1.08.79 2.18 0 1.57-.01 2.83-.01 3.22 0 .31.21.68.81.56 4.64-1.52 7.96-5.83 7.96-10.92C23.5 5.66 18.35.5 12 .5Z" />
                        </svg>
                        {project.data.repoLabel || "GitHub"}
                      </a>
                    )}
                    {project.data.ctaHref && (
                      <a
                        href={project.data.ctaHref}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-xs sm:btn-sm btn-outline border-sage-border/50 text-sage-accent rounded-full font-mono text-[9px] sm:text-[10px] uppercase tracking-wider gap-1 hover:bg-sage-accent hover:text-surface hover:border-sage-accent"
                      >
                        <svg
                          class="w-3 h-3 sm:w-3.5 sm:h-3.5"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M10 6H6a2 2 0 00-2-2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                          />
                        </svg>
                        {project.data.ctaLabel || "Live Demo"}
                      </a>
                    )}
                    {project.data.resultHref && (
                      <a
                        href={project.data.resultHref}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-xs sm:btn-sm btn-outline border-sage-border/50 text-sage-muted rounded-full font-mono text-[9px] sm:text-[10px] uppercase tracking-wider gap-1 hover:bg-sage-accent hover:text-surface hover:border-sage-accent"
                      >
                        <svg
                          class="w-3 h-3 sm:w-3.5 sm:h-3.5"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                          />
                        </svg>
                        {project.data.resultLabel || "Case Study"}
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>

  <!-- Client-side script for filters and masonry -->
  <script is:inline>
    function resizeGridItem(item) {
      const grid = document.getElementById("projects-grid");
      if (!grid) return;

      const inner = item.querySelector(".project-card-inner");
      if (!inner) return;

      // Temporary reset height to auto to measure natural content height
      inner.style.height = "auto";
      item.style.gridRowEnd = "";

      const contentHeight = inner.getBoundingClientRect().height;
      const rowHeight = 10;
      const gap = 24;

      const rowSpan = Math.ceil((contentHeight + gap) / (rowHeight + gap));
      item.style.gridRowEnd = "span " + rowSpan;

      // Set height back to 100% so it stretches to fill the grid item span
      inner.style.height = "100%";
    }

    function resizeAllGridItems() {
      const allItems = document.querySelectorAll(
        "#projects-grid .project-card",
      );
      allItems.forEach((item) => {
        if (item.style.display !== "none") {
          resizeGridItem(item);
        }
      });
    }

    window.resizeAllGridItems = resizeAllGridItems;

    document.addEventListener("DOMContentLoaded", () => {
      // Run once on load
      resizeAllGridItems();
      window.addEventListener("resize", resizeAllGridItems);
      // Wait for images to load
      window.addEventListener("load", resizeAllGridItems);

      // Monitor font loading
      if (document.fonts) {
        document.fonts.ready.then(resizeAllGridItems);
      }

      const buttons = document.querySelectorAll("#filter-container button");
      const cards = document.querySelectorAll("#projects-grid .project-card");

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const filter = btn.getAttribute("data-filter");

          // Update active button styling
          buttons.forEach((b) => {
            b.classList.remove("btn-primary", "text-surface");
            b.classList.add(
              "btn-outline",
              "border-sage-border/50",
              "text-sage-muted",
            );
          });
          btn.classList.add("btn-primary", "text-surface");
          btn.classList.remove(
            "btn-outline",
            "border-sage-border/50",
            "text-sage-muted",
          );

          // Filter card visibilities with simple fade
          cards.forEach((card) => {
            const category = card.getAttribute("data-category");
            if (filter === "All" || category === filter) {
              card.style.display = "flex";
              setTimeout(() => {
                card.style.opacity = "1";
                card.style.transform = "scale(1)";
                resizeAllGridItems();
              }, 10);
            } else {
              card.style.opacity = "0";
              card.style.transform = "scale(0.95)";
              setTimeout(() => {
                card.style.display = "none";
                resizeAllGridItems();
              }, 300);
            }
          });

          resizeAllGridItems();
        });
      });
    });
  </script>
</Layout>
