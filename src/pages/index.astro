---
import Layout from "../layouts/Layout.astro";
---

<Layout isHome={true} title="Alyani Septalia | Portfolio">
  <div
    class="min-h-[75vh] flex flex-col justify-center items-center w-full px-4 py-8"
  >
    <!-- Main Content Card -->
    <div
      id="hero-card"
      class="bg-surface border border-sage-border/40 p-8 md:p-14 rounded-xl shadow-sm max-w-2xl w-full text-center transition-all duration-500 ease-out transform"
    >
      <!-- Brief Intro Paragraph -->
      <p
        class="text-sm md:text-base leading-relaxed text-sage-muted font-sans mb-6"
      >
        <span id="dynamic-greeting">Good day!</span><br />
        <br />I'm <strong class="text-forest-dark font-bold">Alyani</strong>
        <span class="text-xs text-sage-accent font-semibold font-mono"
          >(she/her)</span
        >, a Computer Science graduate from <a
          href="https://unmul.ac.id/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold underline decoration-sage-accent/30 decoration-2 hover:text-sage-accent transition-colors"
          >Universitas Mulawarman</a
        > and multidisciplinary engineer. <br /> Blending a designer’s eye for detail
        with web engineering, I build high-performance web applications and interactive
        data dashboards.
      </p>

      <!-- Bracket Navigation Links -->
      <div
        class="flex flex-wrap justify-center items-center gap-x-4 gap-y-2 text-xs font-mono text-sage-accent mb-6 select-none leading-none"
      >
        <span
          >[<a
            href="/about"
            class="hover:text-forest-dark transition-colors font-bold uppercase tracking-wider"
            >about me</a
          >]</span
        >
        <span
          >[<a
            href="/portfolio"
            class="hover:text-forest-dark transition-colors font-bold uppercase tracking-wider"
            >works</a
          >]</span
        >
        <span
          >[<a
            href="/publications"
            class="hover:text-forest-dark transition-colors font-bold uppercase tracking-wider"
            >publications</a
          >]</span
        >
      </div>

      <!-- Social Media Icons -->
      <div class="flex justify-center items-center gap-6 text-sage-muted mb-6">
        <!-- Email -->
        <a
          href="mailto:septaliaans@gmail.com"
          class="transition-all duration-300 hover:text-sage-accent hover:scale-110"
          aria-label="Email"
        >
          <svg
            class="w-5 h-5"
            viewBox="0 0 24 24"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M4 6.75h16a1.25 1.25 0 0 1 1.25 1.25v8a1.25 1.25 0 0 1-1.25 1.25H4A1.25 1.25 0 0 1 2.75 16v-8A1.25 1.25 0 0 1 4 6.75Zm0 0 8 5 8-5"
            ></path>
          </svg>
        </a>

        <!-- GitHub -->
        <a
          href="https://github.com/AlyaniNS"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-all duration-300 hover:text-sage-accent hover:scale-110"
          aria-label="GitHub"
        >
          <svg
            class="w-5 h-5"
            viewBox="0 0 24 24"
            aria-hidden="true"
            fill="currentColor"
          >
            <path
              d="M12 .5c-6.35 0-11.5 5.16-11.5 11.53 0 5.09 3.34 9.4 7.98 10.92.58.11.8-.25.8-.56 0-.28-.01-1.02-.02-2.01-3.25.71-3.94-1.57-3.94-1.57-.53-1.37-1.3-1.73-1.3-1.73-1.06-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.04 1.79 2.73 1.27 3.4.97.11-.77.41-1.27.75-1.56-2.6-.3-5.33-1.3-5.33-5.78 0-1.27.45-2.32 1.19-3.13-.12-.3-.52-1.49.11-3.11 0 0 .98-.31 3.2 1.2.93-.26 1.93-.39 2.92-.39.99 0 1.99.13 2.92.39 2.22-1.51 3.2-1.2 3.2-1.2.63 1.62.23 2.81.11 3.11.74.81 1.19 1.86 1.19 3.13 0 4.49-2.74 5.48-5.35 5.77.42.37.79 1.08.79 2.18 0 1.57-.01 2.83-.01 3.22 0 .31.21.68.81.56 4.64-1.52 7.96-5.83 7.96-10.92C23.5 5.66 18.35.5 12 .5Z"
            ></path>
          </svg>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://linkedin.com/in/AlyaniNS"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-all duration-300 hover:text-sage-accent hover:scale-110"
          aria-label="LinkedIn"
        >
          <svg
            class="w-5 h-5"
            viewBox="0 0 24 24"
            aria-hidden="true"
            fill="currentColor"
          >
            <path
              d="M20.45 20.45h-3.55v-5.56c0-1.33-.03-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.93v5.66H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.46C23.2 24 24 23.23 24 22.27V1.73C24 .77 23.2 0 22.23 0Z"
            ></path>
          </svg>
        </a>
      </div>

      <!-- Clocks Widget Dashboard -->
      <div
        class="flex justify-center items-center gap-6 pt-4 border-t border-sage-border/20 text-[10px] font-mono text-sage-muted select-none"
      >
        <div class="flex flex-col items-center">
          <span
            class="text-[8px] uppercase tracking-wider text-sage-accent font-semibold mb-0.5"
            >Your Local Time</span
          >
          <span
            id="visitor-time"
            class="text-xs font-bold text-forest-dark tabular-nums"
            >--:--:--</span
          >
        </div>
        <div class="h-6 w-px bg-sage-border/30"></div>
        <div class="flex flex-col items-center">
          <span
            class="text-[8px] uppercase tracking-wider text-forest-dark font-semibold mb-0.5"
            >My Local Time (UTC+8)</span
          >
          <span
            id="my-time"
            class="text-xs font-bold text-forest-dark tabular-nums"
            >--:--:--</span
          >
        </div>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  function updateClocks() {
    const visitorTimeEl = document.getElementById("visitor-time");
    const myTimeEl = document.getElementById("my-time");
    if (!visitorTimeEl || !myTimeEl) return;

    const now = new Date();

    // Visitor Local Time format
    const options = {
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    };
    visitorTimeEl.textContent = now.toLocaleTimeString(undefined, options);

    // My Time (GMT+8)
    const myTimeStr = now.toLocaleTimeString("en-US", {
      timeZone: "Asia/Makassar",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    });
    myTimeEl.textContent = myTimeStr;
  }

  function setDynamicGreeting() {
    const greetingEl = document.getElementById("dynamic-greeting");
    if (!greetingEl) return;
    const hours = new Date().getHours();
    let greeting = "Good day!";
    if (hours >= 5 && hours < 12) {
      greeting = "Good morning!";
    } else if (hours >= 12 && hours < 17) {
      greeting = "Good afternoon!";
    } else if (hours >= 17 && hours < 22) {
      greeting = "Good evening!";
    } else {
      greeting = "Good day!";
    }
    greetingEl.textContent = greeting;
  }

  document.addEventListener("DOMContentLoaded", () => {
    setDynamicGreeting();
    updateClocks();
    setInterval(updateClocks, 1000);
  });
</script>
