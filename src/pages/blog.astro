---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const posts = (await getCollection("posts")).sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const allTags = ["All", ...new Set(posts.flatMap((p) => p.data.tags || []))];
---

<Layout title="Blog | Alyani Septalia" description="Writing & Thoughts by Alyani Septalia.">
  <div class="flex flex-col gap-10 w-full">
    <!-- Header -->
    <div class="flex flex-col gap-3">
      <h1 class="text-3xl md:text-4xl font-mono uppercase tracking-wide text-forest-dark">
        Writing & Thoughts
      </h1>
      <p class="text-sage-muted text-sm">
        Stories, reflections, and field notes from my work, travels, and research.
      </p>
    </div>

    <!-- Tag Filter Pills -->
    <div class="flex flex-wrap gap-2" id="filter-container">
      {allTags.map((tag, index) => (
        <button
          type="button"
          data-filter={tag}
          class={`btn btn-xs sm:btn-sm rounded-full font-mono uppercase tracking-wider ${
            index === 0
              ? "btn-primary text-surface"
              : "btn-outline border-sage-border/50 text-sage-muted hover:bg-sage-accent hover:text-surface hover:border-sage-accent"
          }`}
        >
          {tag}
        </button>
      ))}
    </div>

    <!-- Posts Grid -->
    <div class="flex flex-col gap-6 w-full" id="blog-posts-grid">
      {posts.map((post) => (
        <a 
          href={`/blog/${post.slug}`}
          data-tags={post.data.tags ? post.data.tags.join(",") : ""}
          class="blog-card flex flex-col md:flex-row gap-6 p-5 bg-surface border border-sage-border/40 rounded-xl hover:border-sage-accent transition-all duration-300 transform hover:-translate-y-0.5 group shadow-none"
        >
          <!-- Thumbnail on Left -->
          <div class="w-full md:w-44 h-32 md:h-auto shrink-0 bg-gradient-to-br from-cream/40 to-sage-border/20 rounded-lg border border-sage-border/20 flex items-center justify-center overflow-hidden">
            <svg class="w-8 h-8 text-sage-accent/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
          </div>

          <!-- Content on Right -->
          <div class="flex-grow flex flex-col justify-center gap-2">
            <span class="text-[10px] font-mono text-sage-accent uppercase tracking-wider">
              {new Date(post.data.pubDate).toLocaleDateString("en-US", {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </span>
            <h2 class="font-mono text-base font-bold text-forest-dark leading-snug group-hover:text-sage-accent transition-colors duration-300">
              {post.data.title}
            </h2>
            <p class="text-xs text-sage-muted leading-relaxed">
              {post.data.description}
            </p>
            
            {/* Post Tags */}
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5 pt-0.5">
                {post.data.tags.map((tag) => (
                  <span class="px-2.5 py-0.5 rounded-full bg-cream text-[9px] font-mono text-sage-muted border border-sage-border/25">
                    {tag}
                  </span>
                ))}
              </div>
            )}

            <div class="flex items-center gap-1 mt-1 text-[10px] font-mono tracking-wider uppercase text-sage-accent font-semibold group-hover:underline">
              Read Article
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- Client-side script for filters -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const buttons = document.querySelectorAll("#filter-container button");
      const cards = document.querySelectorAll("#blog-posts-grid .blog-card");

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const filter = btn.getAttribute("data-filter");

          // Update active button styling
          buttons.forEach((b) => {
            b.classList.remove("btn-primary", "text-surface");
            b.classList.add("btn-outline", "border-sage-border/50", "text-sage-muted");
          });
          btn.classList.add("btn-primary", "text-surface");
          btn.classList.remove("btn-outline", "border-sage-border/50", "text-sage-muted");

          // Filter card visibilities with simple fade
          cards.forEach((card) => {
            const tags = card.getAttribute("data-tags").split(",");
            if (filter === "All" || tags.includes(filter)) {
              card.style.display = "flex";
              setTimeout(() => {
                card.style.opacity = "1";
                card.style.transform = "scale(1)";
              }, 10);
            } else {
              card.style.opacity = "0";
              card.style.transform = "scale(0.95)";
              setTimeout(() => {
                card.style.display = "none";
              }, 300);
            }
          });
        });
      });
    });
  </script>
</Layout>
