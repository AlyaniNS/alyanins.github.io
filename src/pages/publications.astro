---
import Layout from "../layouts/Layout.astro";
import publications from "../data/publications.json";
---

<Layout title="Publications | Alyani Septalia" description="Academic works by Alyani Septalia">
  <div class="flex flex-col gap-10 w-full">
    
    <!-- Page Header -->
    <div class="flex flex-col gap-3">
      <h1 class="text-3xl md:text-4xl font-mono uppercase tracking-wide text-forest-dark">
        research & Publications
      </h1>
      <p class="text-sage-muted text-sm">
        Selected academic work, research papers, and conference contributions.
      </p>
    </div>

    <!-- Publications List -->
    <div class="flex flex-col gap-12 mt-4 relative pl-4 md:pl-8 before:absolute before:left-0 before:top-2 before:bottom-2 before:w-[1px] before:bg-sage-border/60">
      {publications.map((pub) => (
        <article class="flex flex-col gap-3 relative group">
          
          <!-- Timeline point indicator -->
          <div class="absolute -left-[20px] md:-left-[36px] top-1.5 w-2 h-2 rounded-full bg-sage-border border border-cream group-hover:bg-sage-accent transition-colors duration-300" />
          
          <div class="flex flex-col gap-1">
            <!-- Title with Date -->
            <h2 class="font-mono text-base font-bold text-forest-dark leading-snug">
              <a 
                href={pub.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="underline decoration-sage-border/60 hover:decoration-sage-accent transition-all duration-300 hover:text-sage-accent"
              >
                {pub.title}
              </a>
              <span class="text-xs font-mono text-sage-accent ml-2 inline-block whitespace-nowrap">
                ({pub.date})
              </span>
            </h2>
            
            <!-- Publisher / Venue -->
            <span class="text-xs font-semibold text-sage-muted tracking-wide mt-1">
              {pub.publisher}
            </span>
          </div>

          <!-- Description/Abstract -->
          <p class="text-sm text-sage-muted/90 leading-relaxed font-sans max-w-3xl">
            {pub.description}
          </p>

          <!-- External Read Link -->
          <div class="flex items-center gap-1 mt-1 text-[11px] font-mono tracking-wider uppercase text-sage-accent/80 hover:text-sage-accent">
            <a href={pub.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5">
              Read Publication
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          </div>
          
        </article>
      ))}
    </div>

  </div>
</Layout>
